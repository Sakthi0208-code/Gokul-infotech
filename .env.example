# Copy this file to .env.local and fill in your values.
# Never commit .env.local. It is excluded by .gitignore.

# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (free tier, fast).
GEMINI_MODEL=

# Secret code an admin types into the chatbot (after typing "admin")
# to open the assistance dashboard at /admin. Use something long and unguessable.
# Leave empty to disable admin access.
ADMIN_ACCESS_CODE=

# Optional but recommended: a long random string used to sign admin sessions.
# Changing it signs every admin out.
ADMIN_SESSION_SECRET=

# Optional: email the customer when their ticket is resolved (any SMTP server).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=a Gmail "app password" (needs 2-Step Verification), not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender name/address and reply-to (defaults to SMTP_USER).
MAIL_FROM=
MAIL_REPLY_TO=

# Optional. Where support tickets are saved (default: data/tickets.json).
TICKETS_FILE=
